{
  "name": "castoff-workspace",
  "private": true,
  "description": "Workspace root: git hooks, formatting, and shared tooling for the Castoff action",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "castoff/**/*.{ts,js}": [
      "prettier --write",
      "pnpm --filter castoff exec eslint --fix"
    ],
    "changelog/**/*.{ts,js}": [
      "prettier --write",
      "pnpm --filter castoff-changelog exec eslint --fix"
    ],
    "**/*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
