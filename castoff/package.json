{
  "name": "castoff",
  "version": "1.0.0",
  "description": "GitHub Action that generates release notes using OpenAI",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "build": "ncc build index.js -o dist --license licenses.txt",
    "prepare": "git -C .. config core.hooksPath .husky 2>/dev/null || git config core.hooksPath .husky",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "**/*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
