{
  "name": "castoff",
  "version": "2.1.0",
  "description": "GitHub Action that generates release notes using OpenAI",
  "main": "dist/index.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "pnpm typecheck && ncc build main.ts -o dist --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "openai": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.1",
    "@types/node": "^26.5.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "yaml": "^2.9.1"
  }
}
